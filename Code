import random

# List of 5 words
words = ["python", "computer", "programming", "developer", "college"]

# Select a random word
word = random.choice(words)

# Create a list to store the hidden word
hidden_word = []

# Hide some letters and show some letters
for letter in word:
    if random.choice([True, False]):
        hidden_word.append(letter)
    else:
        hidden_word.append("_")

guessed_letters = []
wrong_guesses = 0

print("================================")
print("         HANGMAN GAME")
print("================================")

print("Guess the missing letters!")
print("You have 6 wrong guesses.")

while wrong_guesses < 6:

    # Display the word
    print("\nWord:", " ".join(hidden_word))

    # Check if the word is completely guessed
    if "_" not in hidden_word:
        print("\nCongratulations! You won!")
        print("The word was:", word)
        break

    # Take a letter from the player
    guess = input("Enter a letter: ").lower()

    if len(guess) != 1 or not guess.isalpha():
        print("Please enter only one letter.")
        continue

    if guess in guessed_letters:
        print("You already guessed this letter.")
        continue

    guessed_letters.append(guess)

    # Check the guessed letter
    if guess in word:
        print("Correct guess!")

        # Reveal the guessed letter
        for i in range(len(word)):
            if word[i] == guess:
                hidden_word[i] = guess

    else:
        wrong_guesses = wrong_guesses + 1
        print("Wrong guess!")
        print("Wrong guesses:", wrong_guesses, "/ 6")

# Game over
if wrong_guesses == 6:
    print("\nGAME OVER!")
    print("The correct word was:", word)
